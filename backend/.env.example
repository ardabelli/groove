PORT=8000
FRONTEND_URL=http://127.0.0.1:3000

# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# The redirect URI points at the FRONTEND origin's /api/auth/callback route (a
# native Next.js route handler, not proxied), so the session cookie is first-party.
# Locally that's the frontend on :3000; in production it's the deployed frontend
# domain, e.g. https://<frontend-domain>/api/auth/callback. Must match the Spotify
# dashboard exactly.
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Curator LLM. Provider is resolved in backend/src/lib/agent/model.ts.
#   AI_PROVIDER=openai  (default) — set OPENAI_API_KEY, optional AI_MODEL (default gpt-4o)
#   AI_PROVIDER=harmona          — set HARMONA_API_KEY (hapi_... agent key from
#                                  platform.harmona.ai → Agents → API Access).
#                                  The agent must be configured to emit the JSON
#                                  the curator expects.
AI_PROVIDER=harmona
OPENAI_API_KEY=
# AI_MODEL=gpt-4o
HARMONA_API_KEY=
# AI_BASE_URL=            # override provider base URL (defaults to https://api.harmona.ai for harmona)
# HARMONA_USER_ID=groove-curator

# Neon Postgres connection string: https://console.neon.tech
DATABASE_URL=

# Comma-separated Spotify account IDs (not emails/usernames) to auto-promote to admin
# on login. Find an account's ID at https://www.spotify.com/account/overview/ (or via
# the Spotify Web API `/me` response's `id` field) while signed into that account.
# Admins get unlimited prompt credits and can unshare any playlist from the social
# feed. One-way: removing an ID here does not demote an existing admin.
ADMIN_SPOTIFY_IDS=
