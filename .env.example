# URL of the separate Groove backend (see backend/.env.example)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional: enables the real AdSense banner unit (src/components/ads/banner-ad.tsx).
# Leave unset to show a placeholder slot instead.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
