# URL of the separate Groove backend (see backend/.env.example). Despite the
# NEXT_PUBLIC_ prefix this is read server-side, by next.config.ts's rewrite of
# /api/* to this origin — the browser itself never calls it directly, so the
# backend's session cookie stays first-party. Keep the prefix so this can still
# be set as a single env var shared with any code that ends up needing it client-side.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional: enables the real AdSense banner unit (src/components/ads/banner-ad.tsx).
# Leave unset to show a placeholder slot instead.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
